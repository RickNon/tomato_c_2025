<launch>

  <!-- Move base -->
  <group>
    <remap from="/mobile_base/commands/velocity"
          to="/kobuki_operation/cmd_vel"/>
    <include file="$(find tomato_kobuki)/launch/move_base_laser.launch" />
  </group>

  <!-- Kobuki operation -->
  <group>
    <remap from="cmd_vel" to="/cmd_vel_mux/output/cmd_vel"/>
    <include file="$(find tomato_kobuki)/launch/tomato_kobuki_joy.launch" />
  </group>


  <!-- RPLIDAR -->
  <include file="$(find rplidar_ros)/launch/view_rplidar_a1.launch" />

  <!-- Map Server -->
  <arg name="map_file" default="$(find tomato_kobuki)/map/map_kyositu.yaml"/>
  <!-- <arg name="map_file" default="$(find tomato_kobuki)/map/kyositu_2.yaml"/> -->
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />

  <!-- AMCL -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_footprint"/>
    <param name="scan_topic" value="scan"/>
    <param name="transform_tolerance"   value="1.0"/>
    <param name="update_min_d"          value="0.05"/>
    <param name="update_min_a"          value="0.1"/>
  </node>

  <node pkg="topic_tools"
      type="relay"
      name="nav_cmd_relay"
      args="/mobile_base/commands/velocity /kobuki_operation/cmd_vel"
      output="screen"/>

  <!-- Camera -->
  <!-- /dev/video -->
  <!-- 0: Camera1, 2: Camera2 -->
  <node pkg="tomato_launch" type="usb_cam_silent.sh" name="cam_image1" output="screen">
    <param name="video_device" type="string" value="/dev/video0"/>
  </node>
  <!-- <node pkg="tomato_launch" type="usb_cam_silent.sh" name="cam_image1" output="screen">
    <param name="video_device" type="string" value="/dev/video2"/>
  </node> -->


</launch>
